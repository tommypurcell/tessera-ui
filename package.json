{
  "name": "tessera-ui",
  "version": "0.1.0",
  "description": "Searchable Tailwind CSS component registry with structured metadata for humans and coding agents.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin/",
    "public/registry/"
  ],
  "bin": {
    "tessera-ui": "./bin/tessera-ui.js"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm registry:build && pnpm registry:validate && next build",
    "start": "next start",
    "check": "eslint .",
    "test": "playwright test --project=chromium",
    "test:all": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-path .prettierignore",
    "css:blog": "npx @tailwindcss/cli -i ./src/styles/blog.css -o ./public/blog.css -m",
    "css:component": "npx @tailwindcss/cli -i ./src/styles/component.css -o ./public/component.css -m",
    "generate:git-metadata": "node scripts/generate-git-metadata.js",
    "registry:generate": "node scripts/generate-registry.mjs",
    "registry:validate": "node scripts/validate-registry.mjs",
    "registry:build": "node scripts/build-agent-registry.mjs",
    "tessera-ui": "node bin/tessera-ui.js"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.468.0",
    "next": "^16.1.0",
    "next-mdx-remote": "^5.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "zod": "^4.3.6"
  }
}
